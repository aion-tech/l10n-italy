<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- SBF DA PRESENTARE -->

    <record id="cashflow_config_invoice_riba1" model="cashflow.config">
        <field name="model_id" ref="l10n_it_ricevute_bancarie.model_riba_distinta_line"/>
        <field name="name">SBF (Portafoglio da presentare)</field>
        <field name="field_name_formula">
result = self.distinta_id.name
        </field>
        <field name="field_amount_id" ref="l10n_it_ricevute_bancarie.field_riba_distinta_line__amount"/>
        <field name="field_date_id" ref="l10n_it_ricevute_bancarie.field_riba_distinta_line__due_date"/>
        <field name="field_bank_formula">
result = self.distinta_id.config_id.bank_id.id
        </field>
        <field name="field_account_id" ref="l10n_it_ricevute_bancarie.field_riba_distinta_line__acceptance_account_id"/>
        <field name="domain">[["state","in",['draft']]]</field>
    </record>

    <record id="cashflow_config_invoice_riba1_write" model="cashflow.config.update.rule">
        <field name="trigger">write</field>
        <field name="rule">
if self.state not in ['draft']:
    self.unlink_cashflow_records()
        </field>
        <field name="config_id"
            ref="ait_cashflow_forecast_riba.cashflow_config_invoice_riba1"/>
    </record>
    <record id="cashflow_config_invoice_riba1_unlink" model="cashflow.config.update.rule">
        <field name="trigger">unlink</field>
        <field name="rule">self.unlink_cashflow_records()</field>
        <field name="config_id"
            ref="ait_cashflow_forecast_riba.cashflow_config_invoice_riba1"/>
    </record>

    <!-- SBF IN MATURAZIONE -->

    <record id="cashflow_config_invoice_riba2" model="cashflow.config">
        <field name="model_id" ref="l10n_it_ricevute_bancarie.model_riba_distinta_line"/>
        <field name="name">SBF (Portafoglio in maturazione)</field>
        <field name="field_name_formula">
result = self.distinta_id.name
        </field>
        <field name="field_amount_id" ref="l10n_it_ricevute_bancarie.field_riba_distinta_line__amount"/>
        <field name="field_date_id" ref="l10n_it_ricevute_bancarie.field_riba_distinta_line__due_date"/>
        <field name="field_bank_formula">
result = self.distinta_id.config_id.bank_id.id
        </field>
        <field name="field_account_id" ref="l10n_it_ricevute_bancarie.field_riba_distinta_line__acceptance_account_id"/>
        <field name="domain">[["state","=","confirmed"]]</field>
    </record>

    <record id="cashflow_config_invoice_riba2_write" model="cashflow.config.update.rule">
        <field name="trigger">write</field>
        <field name="rule">
if self.state not in ['draft']:
    self.unlink_cashflow_records()
        </field>
        <field name="config_id"
            ref="ait_cashflow_forecast_riba.cashflow_config_invoice_riba1"/>
    </record>
    <record id="cashflow_config_invoice_riba1_unlink" model="cashflow.config.update.rule">
        <field name="trigger">unlink</field>
        <field name="rule">self.unlink_cashflow_records()</field>
        <field name="config_id"
            ref="ait_cashflow_forecast_riba.cashflow_config_invoice_riba1"/>
    </record>

</odoo>
