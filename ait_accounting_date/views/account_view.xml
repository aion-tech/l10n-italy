<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_acc_date" model="ir.ui.view">
        <field name="name">account.move.form.acc.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_date" position="after">
                <field name="date_accounting"/>
            </field>
            <field name="to_check" position="after">
                <field name="valid_date_accounting"/>
            </field>
            <xpath expr="//header//button[last()]" position="after">
                <button
                    name="button_date_validate"
                    type="object"
                    string="Confirm Accouting Date"
                    class="oe_highlight"
                    attrs="{'invisible': [('valid_date_accounting', '!=', False)]}"/>
            </xpath>
            <xpath expr="//page[@id='aml_tab']//field[@name='date_maturity']" position="after">
                <field name="date_accounting"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_acc_date" model="ir.ui.view">
        <field name="name">account.move.line.tree.acc.date</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="date_maturity" position="after">
                <field name="date_accounting" optional="show"/>
            </field>
        </field>
    </record>

</odoo>