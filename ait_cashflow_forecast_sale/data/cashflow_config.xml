<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="cashflow_config_sale_order" model="cashflow.config">
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="name">Quotation / Sale Order</field>
        <field name="field_name_id" ref="sale.field_sale_order__name"/>
        <field name="field_partner_id" ref="sale.field_sale_order__partner_id"/>
        <field name="field_amount_id" ref="sale.field_sale_order__amount_total"/>
        <field name="field_date_formula">
result = (self.commitment_date or self.expected_date) + timedelta(days = self.company_id.cashflow_billing_lead_time)  
        </field>
        <field name="field_pt_id" ref="sale.field_sale_order__payment_term_id"/>
        <field name="field_journal_formula">
result = self.env['account.journal'].search([('type', '=', 'sale')], limit=1)
        </field>
        <field name="field_bank_formula">
result = self.env['res.partner.bank'].search(
    [
        ('partner_id', '=', self.env.user.company_id.partner_id.id)
    ], limit=1)
        </field>
        <field name="field_account_formula">
result = self.partner_id.property_account_receivable_id.id
        </field>
        <field name="domain">[]</field>
    </record>

    <record id="cashflow_config_sale_order_write" model="cashflow.config.update.rule">
        <field name="trigger">write</field>
        <field name="rule">
if self.state not in ['cancel']:
    self._create_cashflow_record()
if self.state in ["cancel"]:
    self.unlink_cashflow_records()
        </field>
        <field name="config_id"
            ref="ait_cashflow_forecast_sale.cashflow_config_sale_order"/>
    </record>
    <record id="cashflow_config_sale_order_unlink" model="cashflow.config.update.rule">
        <field name="trigger">unlink</field>
        <field name="rule">self.unlink_cashflow_records()</field>
        <field name="config_id"
            ref="ait_cashflow_forecast_sale.cashflow_config_sale_order"/>
    </record>

</odoo>
