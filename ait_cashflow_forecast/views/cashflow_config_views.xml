<?xml version="1.0"?>
<odoo>
    <!-- Cashflow Config -->
    <record
    id="cashflow_config_form"
    model="ir.ui.view">
        <field name="name">cashflow.config.form</field>
        <field name="model">cashflow.config</field>
        <field
        name="arch"
        type="xml">
            <form string="Cashflow Record Configuration">
                <group>
                    <group>
                        <field name="name" />
                    </group>
                    <separator />
                    <group>
                        <field
                        name="model_id"
                        domain="[('cashflow_enabled', '=', True)]" />
                        <field
                        name="model_name"
                        invisible="1" />
                    </group>
                    <separator />
                    <group
                    colspan="8"
                    col="4">
                        <field
                        name="field_name_id"
                        domain="[('model_id', '=', model_id)]" />
                        <field
                        name="field_name_formula"
                        widget="ace"
                        options="{'mode': 'python'}" />
                    </group>
                    <separator />
                    <group
                    colspan="8"
                    col="4">
                        <field
                        name="field_partner_id"
                        domain="[('model_id', '=', model_id)]" />
                        <field
                        name="field_partner_formula"
                        widget="ace"
                        options="{'mode': 'python'}" />
                    </group>
                    <separator />
                    <group
                    colspan="16"
                    col="4">
                        <field
                        name="field_amount_id"
                        domain="[('model_id', '=', model_id)]" />
                        <field
                        name="amount_sign_formula"
                        widget="ace"
                        options="{'mode': 'python'}" />
                        <field
                        name="field_amount_formula"
                        widget="ace"
                        options="{'mode': 'python'}" />
                    </group>
                    <separator />
                    <group
                    colspan="8"
                    col="4">
                        <field
                        name="field_date_id"
                        domain="[('model_id', '=', model_id)]" />
                        <field
                        name="field_date_formula"
                        widget="ace"
                        options="{'mode': 'python'}" />
                    </group>
                    <separator />
                    <group
                    colspan="8"
                    col="4">
                        <field
                        name="field_account_id"
                        domain="[('model_id', '=', model_id)]" />
                        <field
                        name="field_account_formula"
                        widget="ace"
                        options="{'mode': 'python'}" />
                    </group>
                    <separator />
                    <group
                    colspan="8"
                    col="4">
                        <field
                        name="field_journal_id"
                        domain="[('model_id', '=', model_id)]" />
                        <field
                        name="field_journal_formula"
                        widget="ace"
                        options="{'mode': 'python'}" />
                    </group>
                    <separator />
                    <group
                    colspan="8"
                    col="4">
                        <field
                        name="field_bank_id"
                        domain="[('model_id', '=', model_id)]" />
                        <field
                        name="field_bank_formula"
                        widget="ace"
                        options="{'mode': 'python'}" />
                    </group>
                    <separator />
                    <group
                    colspan="8"
                    col="4">
                        <field
                        name="field_pt_id"
                        domain="[('model_id', '=', model_id)]" />
                        <field
                        name="field_pt_formula"
                        widget="ace"
                        options="{'mode': 'python'}" />
                    </group>
                </group>
                <separator />
                <group>
                    <field
                    name="domain"
                    widget="domain"
                    options="{'model': 'model_name'}" />
                </group>
                <notebook>
                    <page
                    name="rules"
                    string="Rules">
                        <field
                        name="rule_ids"
                        nolabel="1">
                            <form string="Update Rule">
                                <group>
                                    <field
                                    name="config_id"
                                    invisible="1" />
                                    <field name="trigger" />
                                    <field
                                    name="rule"
                                    widget="ace"
                                    options="{'mode': 'python'}" />
                                    <field name="server_action_id" />
                                </group>
                            </form>
                            <tree string="Update Rules">
                                <field name="trigger" />
                                <field name="rule" />
                                <field name="server_action_id" />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>
    <record
    id="cashflow_config_tree"
    model="ir.ui.view">
        <field name="name">cashflow.config.tree</field>
        <field name="model">cashflow.config</field>
        <field
        name="arch"
        type="xml">
            <tree string="Cashflow Record Configurations">
                <field name="model_id" />
                <field name="name" />
                <field name="domain" />
                <field name="rule_ids" />
            </tree>
        </field>
    </record>
    <record
    id="action_cashflow_config"
    model="ir.actions.act_window">
        <field name="name">Cashflow Record Configurations</field>
        <field name="res_model">cashflow.config</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
    id="menu_cashflow_config"
    parent="account.account_management_menu"
    name="Cashflow Record Configurations"
    sequence="99"
    action="action_cashflow_config" />
</odoo>
