<odoo>
    <record
    model="ir.ui.view"
    id="ait_cashflow_forecast_account_move_form_view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field
        name="inherit_id"
        ref="account.view_move_form" />
        <field
        name="arch"
        type="xml">
            <xpath
            expr="//div[@name='button_box']"
            position="inside">
                <button
                name="open_cashflow_records"
                type="object"
                class="oe_stat_button"
                icon="fa-money">
                    <field
                    name="cashflow_records_count"
                    widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
