<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- CUSTOMER INVOICE -->

    <record id="cashflow_config_invoice" model="cashflow.config">
        <field name="model_id" ref="account.model_account_move"/>
        <field name="name">Fatture Cliente</field>
        <field name="field_name_id" ref="account.field_account_move__name"/>
        <field name="field_partner_id" ref="account.field_account_move__partner_id"/>
        <field name="field_amount_id" ref="account.field_account_move__amount_total"/>
        <field name="field_date_formula">
result = (self.invoice_date_due or self._fields['invoice_date'].context_today(self)) + timedelta(days = self.company_id.cashflow_billing_lead_time)
        </field>
        <field name="field_pt_id" ref="account.field_account_move__invoice_payment_term_id"/>
        <field name="field_journal_id" ref="account.field_account_move__journal_id"/>
        <field name="field_bank_formula">
result = self.partner_bank_id or self.env['res.partner.bank'].search(
    [
        ('partner_id', '=', self.company_id.partner_id.id)
    ], limit=1)
        </field>
        <field name="field_account_formula">
result = self.partner_id.property_account_receivable_id.id
        </field>
        <field name="domain">[("move_type","in",['out_invoice'])]</field>
    </record>

    <record id="cashflow_config_invoice_write" model="cashflow.config.update.rule">
        <field name="trigger">write</field>
        <field name="rule">
self.unlink_cashflow_records()
if not self.state in ['cancel']:
    self._create_cashflow_record()
        </field>
        <field name="config_id"
            ref="ait_cashflow_forecast_account.cashflow_config_invoice"/>
    </record>
    <record id="cashflow_config_invoice_unlink" model="cashflow.config.update.rule">
        <field name="trigger">unlink</field>
        <field name="rule">self.unlink_cashflow_records()</field>
        <field name="config_id"
            ref="ait_cashflow_forecast_account.cashflow_config_invoice"/>
    </record>
    <record id="cashflow_config_invoice_create" model="cashflow.config.update.rule">
        <field name="trigger">create</field>
        <field name="rule">
if "sale.order" in self.env.keys():
    self.env['sale.order'].search([('invoice_ids', 'in', [self.id])]).unlink_cashflow_records()</field>
        <field name="config_id"
            ref="ait_cashflow_forecast_account.cashflow_config_invoice"/>
    </record>

    <!-- VENDOR BILL -->

    <record id="cashflow_config_bill" model="cashflow.config">
        <field name="model_id" ref="account.model_account_move"/>
        <field name="name">Fatture Fornitore</field>
        <field name="field_name_id" ref="account.field_account_move__name"/>
        <field name="field_partner_id" ref="account.field_account_move__partner_id"/>
        <field name="field_amount_id" ref="account.field_account_move__amount_total"/>
        <field name="amount_sign_formula">result = -1</field>
        <field name="field_date_formula">
result = (self.invoice_date or self._fields['invoice_date'].context_today(self)) + timedelta(days = self.company_id.cashflow_billing_lead_time)
        </field>
        <field name="field_pt_id" ref="account.field_account_move__invoice_payment_term_id"/>
        <field name="field_journal_id" ref="account.field_account_move__journal_id"/>
        <field name="field_bank_formula">
result = self.partner_bank_id or self.env['res.partner.bank'].search(
    [
        ('partner_id', '=', self.company_id.partner_id.id)
    ], limit=1)
        </field>
        <field name="field_account_formula">
result = self.partner_id.property_account_payable_id.id
        </field>
        <field name="domain">[("move_type","in",['in_invoice'])]</field>
    </record>

    <record id="cashflow_config_bill_write" model="cashflow.config.update.rule">
        <field name="trigger">write</field>
        <field name="rule">
self.unlink_cashflow_records()
if self.state not in ['cancel']:
    self._create_cashflow_record()
        </field>
        <field name="config_id"
            ref="ait_cashflow_forecast_account.cashflow_config_bill"/>
    </record>
    <record id="cashflow_config_bill_unlink" model="cashflow.config.update.rule">
        <field name="trigger">unlink</field>
        <field name="rule">self.unlink_cashflow_records()</field>
        <field name="config_id"
            ref="ait_cashflow_forecast_account.cashflow_config_bill"/>
    </record>
    <record id="cashflow_config_bill_create" model="cashflow.config.update.rule">
        <field name="trigger">create</field>
        <field name="rule">
if "purchase.order" in self.env.keys():
    self.env['purchase.order'].search([('invoice_ids', 'in', [self.id])]).unlink_cashflow_records()
        </field>
        <field name="config_id"
            ref="ait_cashflow_forecast_account.cashflow_config_bill"/>
    </record>

</odoo>
