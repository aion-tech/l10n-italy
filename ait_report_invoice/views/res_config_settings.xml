<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ait_report_invoice_res_setting_form" model="ir.ui.view">
        <field name="name">ait.report.invoice.res.setting.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invoicing_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="shipping_info_on_invoice">
                    <div class="o_setting_left_pane">
                        <field name="shipping_info_on_invoice"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="shipping_info_on_invoice"/>
                        <div class="text-muted">
                            <p>
                                Shows the shipping information on the customer invoice reports.
                            </p>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>