<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_invoice_report" model="ir.ui.view">
        <field name="name">account.move.form.invoice.report</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="compute_pricelist_client_ref_on_lines" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_tree_invoice_report" model="ir.ui.view">
        <field name="name">view.tree.invoice.report</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="compute_pricelist_client_ref_on_lines" invisible="1"/>
            </xpath>
        </field>
    </record>
    

</odoo>
