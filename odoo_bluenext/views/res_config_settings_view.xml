<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record
    id="view_account_config_settings_bluenext"
    model="ir.ui.view">
        <field name="name">view_account_config_settings_bluenext</field>
        <field name="model">res.config.settings</field>
        <field
        name="inherit_id"
        ref="l10n_it_fatturapa.view_account_config_settings" />
        <field
        name="arch"
        type="xml">
            <xpath
            expr="//div[@id='fatturapa_settings']"
            position="after">
                <div
                class="row mt16 o_settings_container"
                id="bluenext_config_settings">
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Bluenext</span>
                            <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            aria-label="Values set here are company-specific."
                            groups="base.group_multi_company"
                            role="img" />
                            <div class="content-group">
                                <div class="row">
                                    <label
                                    for="bluenext_base_url"
                                    class="col-lg-2 o_light_label" />
                                    <field name="bluenext_base_url" />
                                </div>
                                <div class="row">
                                    <label
                                    for="bluenext_username"
                                    class="col-lg-2 o_light_label" />
                                    <field name="bluenext_username" />
                                </div>
                                <div class="row">
                                    <label
                                    for="bluenext_password"
                                    class="col-lg-2 o_light_label" />
                                    <field
                                    name="bluenext_password"
                                    password="1" />
                                </div>
                                <div class="row">
                                    <label
                                    for="bluenext_last_download_date"
                                    class="col-lg-2 o_light_label" />
                                    <field name="bluenext_last_download_date" />
                                </div>
                                <div class="row">
                                    <label
                                    for="bluenext_state_map_ids"
                                    class="col-lg-2 o_light_label" />
                                    <field name="bluenext_state_map_ids">
                                        <tree editable="bottom">
                                            <field name="odoo_attachment_out_state" />
                                            <field name="bluenext_invoice_state" />
                                        </tree>
                                    </field>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
